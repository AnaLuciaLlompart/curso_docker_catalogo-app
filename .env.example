# Contrato de variables de catalogo-app. Copiar a .env y completar.
# .env NO se versiona (está en .gitignore); este archivo sí.

# ---- catalogo-db (imagen mongo:7) ----
# Crean el usuario root en la base "admin". Solo se aplican sobre un volumen vacío.
DB_USER=catalogo_user          # consumida por catalogo-db (MONGO_INITDB_ROOT_USERNAME) y catalogo-api (DB_USER)
DB_PASSWORD=cambiar_esta_clave # consumida por catalogo-db (MONGO_INITDB_ROOT_PASSWORD) y catalogo-api (DB_PASSWORD). SECRETO.

# ---- catalogo-api (FastAPI) ----
DB_NAME=catalogodb             # base de trabajo de la API; la URI termina en /catalogodb?authSource=admin
APP_VERSION=v1                 # lo que devuelve /health en "version"; horneada en la imagen con ARG+ENV, acá se sobreescribe
# Fijas en docker-compose.yml (no cambian entre entornos):
#   DB_HOST=catalogo-db   nombre del servicio, lo resuelve el DNS de catalogo-net
#   DB_PORT=27017
#   ROOT_PATH=/api        prefijo bajo el que el proxy publica la API; sin él, /api/docs no funciona
#   SEED_DEMO=true        siembra idempotente del catálogo de ejemplo
# Alternativa: MONGO_URI=mongodb://usuario:clave@catalogo-db:27017/catalogodb?authSource=admin
#   Si se usa, la cadena CONTIENE la contraseña: va completa en el Secret de la semana 7, nunca en un ConfigMap.

# ---- catalogo-frontend (nginx) ----
# Fijas en docker-compose.yml; nginx las sustituye al arrancar (envsubst, filtro ^API_):
#   API_HOST=catalogo-api
#   API_PORT=8000